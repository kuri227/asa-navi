    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "test-renderer": "1.3.0",
    "uuid": "11.1.1"
  },
  "jest": {
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/test/style-mock.js"
    },
    "preset": "jest-expo"
  },
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web --output-dir dist",
    "web:preview": "node ./scripts/preview-web.js",
    "lint": "expo lint",
    "migration:check": "node ./scripts/generate-migrations.js --check",
    "migration:generate": "node ./scripts/generate-migrations.js",
    "test": "jest --runInBand",
    "test:sqlite": "node ./scripts/test-sqlite-integration.js",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "private": true
